# Optional OpenAI-compatible LLM. Leave unset for fully offline demo.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# (Groq: llama-3.3-70b-versatile was retired Aug 2026 — use gpt-oss-* or check console.groq.com/docs/models)
# Alt example: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat

# Optional Cursor SDK harness (npm run harness:brief)
# CURSOR_API_KEY=

# Collect / subscribe
# PUBLIC_BASE_URL=http://localhost:5179
# COLLECT_INTERVAL_MINUTES=60
# COLLECT_API_TOKEN=   # required in production for POST /api/collect/run
# SUBSCRIBE_WEBHOOK_URL=

# PORT=5179
# NODE_ENV=production   # set automatically by Render; enables static dist/ serve

# Gate audit JSONL (default on). Set to 0 to disable.
# YANXI_AUDIT=1
