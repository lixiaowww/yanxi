# Optional TypeSafe Jev (System One) — gray-zone intake second cut only.
# First cut remains whitelist + hard nuggets. Jev never writes briefs, never
# overrides admit/social, never covers ethics/quote gate.
# TYPESAFE_API_KEY=
# JEV_API_KEY=                 # alias for TYPESAFE_API_KEY
# JEV_MODEL=jev-1.13.0
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_IN_TESTS=1               # allow live Jev inside npm run test:intake

# Optional OpenAI-compatible LLM. Leave unset for fully offline demo.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# (Groq: llama-3.3-70b-versatile was retired Aug 2026 — use gpt-oss-* or check console.groq.com/docs/models)
# Alt example: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat

# Optional second OpenAI-compatible provider (src/lib/llm.ts). Used only when
# the primary LLM_* call fails for any reason — a 429 rate limit is the one
# actually seen in production on Groq's free/on-demand tier (see
# docs/DP-brief-quality.md §4.7). BriefResponse.llmProvider says which
# provider actually answered ("primary"|"fallback"). Leave unset to disable —
# the pipeline falls back to the offline template path as before.
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# LLM_FALLBACK_MODEL=deepseek-chat

# F13 Outlook enrichment (src/lib/scenario-enrich.ts): one extra LLM call per
# brief that rewrites alternative/falsifier for every scenario together (ACH
# pattern) so they read as distinct instead of the rule engine's shared
# fallback sentence. Only runs when an LLM is configured and forceOffline is
# not set; soft-fails to the rule-based text on any error. Adds ~1 extra LLM
# call's cost/latency per adopted brief — set to 0 to skip it and save quota.
# YANXI_SCENARIO_ENRICH=1

# Optional Cursor SDK harness (npm run harness:brief)
# CURSOR_API_KEY=

# Optional live search context (F33, src/lib/search-context.ts): before the
# LLM call, runs 3 fixed-angle Tavily searches (background/history, critical/
# comparative, category-specific) on excerpts that pass intake, injected as a
# clearly-external "background" context block the model must cite by URL.
# Leave unset to skip this step entirely — the pipeline behaves exactly as
# without it. Sign up at tavily.com.
# TAVILY_API_KEY=

# Optional outbox persistence "方案B" (F32, src/lib/outbox-archive.ts): after
# each real collect run, snapshots the live outbox to this repo's own GitHub
# Contents API (outbox/archive/public-live-collect.json) as a free
# alternative to a paid Render Persistent Disk. Needs a GitHub PAT with
# contents:write on this repo. Restoring the snapshot at boot needs no
# token — the repo is public. Leave unset to skip archiving; restore still
# works (reads a public URL), it just has nothing to restore yet.
# GITHUB_ARCHIVE_TOKEN=
# GITHUB_ARCHIVE_REPO=lixiaowww/yanxi   # only needed if forking to a different repo
# GITHUB_ARCHIVE_BRANCH=main

# Collect / subscribe
# PUBLIC_BASE_URL=http://localhost:5179
# COLLECT_INTERVAL_MINUTES=60
# SUBSCRIBE_WEBHOOK_URL=

# Public-demo abuse guard (server.ts + src/lib/api-guard.ts)
# /api/brief and /api/collect/run are open; abuse control is IP rate limiting.
# BRIEF_RATE_MAX=20            # /api/brief calls per IP per window (all modes)
# BRIEF_RATE_WINDOW_MS=600000  # rate-limit window, default 10 minutes
# COLLECT_RATE_MAX=6           # /api/collect/run calls per IP per window
# BRIEF_BODY_LIMIT=128kb       # express.json body cap
# BRIEF_MAX_SOURCE_CHARS=24000 # total paste characters before 413
# TRUST_PROXY_HOPS=1           # proxy hops to trust for client IP (Render: 1)

# PORT=5179
# NODE_ENV=production   # set automatically by Render; enables static dist/ serve

# Gate audit JSONL (default on). Set to 0 to disable.
# YANXI_AUDIT=1
